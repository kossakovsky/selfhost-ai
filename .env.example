# Published image tag to run: latest, a release like v1.0.0, or sha-1a2b3c4.
LINKEDGROW_VERSION=latest

# Generated on install. ENCRYPTION_KEY must stay the value the credentials were
# stored with, so keep both with your backup: a new key makes every saved
# LinkedIn password, 2FA secret and AI key permanently unreadable.
LINKEDGROW_AUTH_SECRET=
LINKEDGROW_ENCRYPTION_KEY=

