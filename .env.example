############
# [optional]
# Docling configuration
# DOCLING_IMAGE: Choose CPU or GPU version
#   - ghcr.io/docling-project/docling-serve-cpu (4.4 GB, default)
#   - ghcr.io/docling-project/docling-serve-cu126 (10.0 GB, NVIDIA GPU with CUDA 12.6)
#   - ghcr.io/docling-project/docling-serve-cu128 (11.4 GB, NVIDIA GPU with CUDA 12.8)
# Note: Web UI is always enabled on /ui
#
# VLM Pipeline Configuration:
# DOCLING_SERVE_ENABLE_REMOTE_SERVICES: Required for VLM via external APIs (Ollama, vLLM)
# DOCLING_SERVE_LOAD_MODELS_AT_BOOT: Pre-load standard models at startup
# DOCLING_DEVICE: Device for model inference (cpu, cuda, mps)
############
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve-cpu
DOCLING_SERVE_ENABLE_REMOTE_SERVICES=true
DOCLING_SERVE_LOAD_MODELS_AT_BOOT=false
DOCLING_DEVICE=cpu

############
# [optional]
# n8n-MCP configuration
#
# N8N_API_KEY: n8n Public API key. LEAVE BLANK to run n8n-MCP in
#   documentation-only mode (node docs, property schemas, templates,
#   validation). Paste a key to also unlock the workflow-management tools
#   (create/update/delete workflows, executions, credentials).
#   Create one in the n8n UI: Settings -> n8n API -> Create an API key,
#   then run 'make restart'.
#   WARNING: outside n8n Enterprise, API keys have FULL access to the account
#   (scopes are an Enterprise feature). Treat this like a root credential.
# N8N_API_URL: internal n8n address; leave as-is unless n8n runs elsewhere.
#   '/api/v1' is appended automatically by n8n-MCP.
# N8N_MCP_WEBHOOK_SECURITY_MODE: n8n-MCP's SSRF guard. 'permissive' is required
#   for the internal http://n8n:5678 target, because 'strict' (the upstream
#   default) and 'moderate' both reject Docker's private IP ranges and would
#   fail every n8n API call. Cloud-metadata endpoints stay blocked either way.
# N8N_MCP_TELEMETRY_DISABLED: upstream enables anonymous telemetry by default.
# N8N_MCP_IMAGE: pin a specific tag here if you do not want ':latest'.
# N8N_MCP_LOG_LEVEL: error, warn, info or debug. Raise to debug when tool calls
#   fail; the logs go to 'docker compose -p localai logs n8n-mcp'.
############
N8N_MCP_IMAGE=ghcr.io/czlonkowski/n8n-mcp:latest
N8N_API_URL=http://n8n:5678
N8N_API_KEY=
N8N_MCP_WEBHOOK_SECURITY_MODE=permissive
N8N_MCP_TELEMETRY_DISABLED=true
N8N_MCP_LOG_LEVEL=info

############
# [optional]
# Ollama configuration
# OLLAMA_GPU_COUNT: Number of NVIDIA GPUs reserved for Ollama (gpu-nvidia profile only).
# Set to a number (e.g. 2) or "all" to use every available GPU.
# OLLAMA_GPU_DEVICES: Pin Ollama to specific NVIDIA GPU IDs on multi-GPU hosts,
# e.g. OLLAMA_GPU_DEVICES=1,2 (comma-separated, no spaces; GPU UUIDs also work).
# When set, it takes precedence over OLLAMA_GPU_COUNT. Leave empty to keep the
# count-based behavior. Applied on the next make restart / make update.
# Both are ignored by the CPU and AMD variants.
#
# Runtime tuning (all hardware variants). Defaults match previous behavior.
# OLLAMA_MAX_LOADED_MODELS: Max models loaded concurrently, in total across all
# GPUs (Ollama's own default is 3 x GPU count). Raise on multi-GPU / high-VRAM
# hosts to avoid model eviction.
# OLLAMA_NUM_PARALLEL: Max parallel requests each model handles. Leave empty to
# use Ollama's built-in default.
# OLLAMA_GPU_OVERHEAD: VRAM to reserve per GPU, in bytes (e.g. 2147483648 = 2 GiB).
# Useful when Ollama shares a GPU with other tools such as InvokeAI.
# OLLAMA_CONTEXT_LENGTH: Default context window size in tokens.
# OLLAMA_KV_CACHE_TYPE: K/V cache quantization (f16, q8_0 or q4_0).
# OLLAMA_SCHED_SPREAD: Set to 1 to spread every model across all GPUs instead of
# packing each onto one GPU. Packing can strand free VRAM until a model fits
# nowhere and falls back to slow CPU/GPU hybrid execution. Use 1 or 0 only (any
# other non-empty value counts as enabled). Ignored on single-GPU and CPU hosts.
# OLLAMA_KEEP_ALIVE: How long an idle model stays in VRAM, e.g. 20m or 1h
# (negative = forever). Always add a unit - a bare number means seconds. Leave
# empty for Ollama's default (currently 5m).
#
# OLLAMA_INSTANCE_COUNT: Number of Ollama containers to run (default 1,
# maximum 8). Set to 2 or more on a multi-GPU host to dedicate a GPU (or a set
# of GPUs) to a specific model, so models are not swapped in and out: instance
# 1 is "ollama", extras are "ollama2", "ollama3", ... reachable internally at
# http://ollama2:11434. There are no published ports - use a
# caddy-addon/site-*.conf file if you need external access to a specific
# instance. All instances share the same model storage, so each model is
# downloaded only once. Extra instances are generated into
# docker-compose.ollama-instances.yml by scripts/generate_ollama_instances.sh,
# which runs automatically during make install / make update.
#
# Per-instance overrides: the runtime tuning knobs above - KEEP_ALIVE,
# NUM_PARALLEL, MAX_LOADED_MODELS, CONTEXT_LENGTH, KV_CACHE_TYPE, GPU_OVERHEAD,
# SCHED_SPREAD - plus GPU_DEVICES can be set per instance with an OLLAMA<N>_
# prefix, for example:
#   OLLAMA_GPU_DEVICES=0,1
#   OLLAMA2_GPU_DEVICES=2
#   OLLAMA2_KEEP_ALIVE=-1
#   OLLAMA2_MAX_LOADED_MODELS=1
# An unset per-instance runtime knob falls back to the global OLLAMA_* value,
# then to the stack default. OLLAMA<N>_GPU_DEVICES is the exception: it does not
# read the global OLLAMA_GPU_DEVICES, see below. Changes take effect on the next
# make restart - no regeneration needed. OLLAMA_GPU_COUNT has no per-instance
# form, and OLLAMA_FLASH_ATTENTION is always on.
#
# OLLAMA<N>_GPU_DEVICES defaults to GPU N-1 (ollama2 -> GPU 1, ollama3 -> GPU 2),
# so on a single-GPU host do not raise the count above 1. When running several
# instances also set OLLAMA_GPU_DEVICES for instance 1, otherwise it takes an
# arbitrary GPU that may already be pinned to another instance.
# NVIDIA only: OLLAMA_GPU_DEVICES is ignored by the CPU and AMD variants. On
# gpu-amd, extra instances are pinned with HIP_VISIBLE_DEVICES but instance 1
# still sees every GPU - override it in docker-compose.override.yml if that
# matters.
############
OLLAMA_INSTANCE_COUNT=1
OLLAMA_GPU_COUNT=1
OLLAMA_GPU_DEVICES=
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=
OLLAMA_GPU_OVERHEAD=0
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_SCHED_SPREAD=
OLLAMA_KEEP_ALIVE=

############
# [optional]
# InvokeAI configuration
# INVOKEAI_GPU_COUNT: Number of NVIDIA GPUs reserved for InvokeAI (invokeai-nvidia
# profile only). Set to a number (e.g. 2) or "all" to use every available GPU.
# INVOKEAI_GPU_DEVICES: Pin InvokeAI to specific NVIDIA GPU IDs on multi-GPU hosts,
# e.g. INVOKEAI_GPU_DEVICES=0 (comma-separated, no spaces; GPU UUIDs also work).
# When set, it takes precedence over INVOKEAI_GPU_COUNT. Leave empty to keep the
# count-based behavior. Applied on the next make restart / make update.
# Both are ignored by the CPU and AMD variants.
# RENDER_GROUP_ID: Host GID of the "render" group, required for the AMD (ROCm) variant
# to access /dev/kfd and /dev/dri. Find it with: getent group render | cut -d: -f3
# Leave RENDER_GROUP_ID empty for the NVIDIA/CPU variants.
############
INVOKEAI_GPU_COUNT=1
INVOKEAI_GPU_DEVICES=
RENDER_GROUP_ID=

##########################################################################################